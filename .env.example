# Copie para .env e preencha. NÃO comite o .env (já está no .gitignore).
#
# Nada aqui é obrigatório pra subir o servidor. Cada bloco liga um recurso; o que
# fica vazio simplesmente não funciona, e a API diz isso em vez de falhar calada.

# ====================================================================
# LLM
# ====================================================================
# Chave do OpenRouter — OPCIONAL aqui: o ideal é o site mandar a chave do usuário
# no header X-OR-Key. Só preencha se quiser uma chave padrão no servidor (ela é
# necessária pro webhook do Discord/Telegram, que não tem header de usuário).
OPENROUTER_API_KEY=

# Modelo padrão quando o site não especificar
DEFAULT_MODEL=openai/gpt-4.1-mini

# --- Fallback local (Seção 5 do prompt mestre) ---
# Sem internet ou sem chave, a conversa cai num modelo rodando na sua máquina.
# O Ollama expõe API compatível com a OpenAI em /v1. Vazio = sem fallback: falha
# honesta em vez de silêncio.
#   OLLAMA_BASE=http://localhost:11434/v1
#   OLLAMA_MODEL=llama3.2
OLLAMA_BASE=
OLLAMA_MODEL=

# ====================================================================
# ACESSO
# ====================================================================
# Domínios do site que podem chamar o backend (separados por vírgula).
# Ex.: https://victorold12.github.io,https://vtz-life-47067.web.app,http://localhost:8080
# Use * só em teste.
ALLOWED_ORIGINS=*

# Token de acesso — OBRIGATÓRIO se você publicar o backend na internet (Render/
# Railway/Fly). Invente uma senha longa e aleatória. Cole o MESMO valor no site
# em Config > Backend VTz OS > "Token de acesso". Vazio = backend aberto (ok só
# em uso local).
BACKEND_TOKEN=

# Rate limit por IP: requisições por janela (segundos). O padrão é generoso de
# propósito — isto é single-user, e UMA interação do painel já faz várias
# chamadas (catálogo, agente, extração de fato, camada diária, busca). É a
# segunda linha de defesa, não a primeira: quem protege é o BACKEND_TOKEN.
RATE_LIMIT=600
RATE_WINDOW=300

# ====================================================================
# MEMÓRIA — busca semântica
# ====================================================================
# Sem isto a busca em /api/memory/search é LÉXICA (compara termos, não acha
# sinônimo) e a resposta declara `mode: "lexical"`. Com isto ela vira semântica
# de verdade.
#
# Serve qualquer endpoint compatível com a API da OpenAI (POST /embeddings):
#
#   OpenAI:            EMBEDDINGS_BASE=https://api.openai.com/v1
#                      EMBEDDINGS_MODEL=text-embedding-3-small
#                      EMBEDDINGS_KEY=sk-...
#
#   Ollama (local):    EMBEDDINGS_MODEL=nomic-embed-text
#                      (a URL é herdada de OLLAMA_BASE — não precisa repetir;
#                       antes rode: ollama pull nomic-embed-text)
#
#   HuggingFace TEI / LM Studio / vLLM: aponte EMBEDDINGS_BASE pro seu servidor.
#
# Depois de configurar (ou TROCAR de modelo), rode POST /api/memory/reindex:
# vetor de modelo diferente não é comparável, e a busca se recusa a misturar.
EMBEDDINGS_BASE=
EMBEDDINGS_MODEL=
EMBEDDINGS_KEY=

# ====================================================================
# DISCORD / TELEGRAM (Seção 5)
# ====================================================================
# Sem MESSAGING_SECRET o webhook fica desligado. O segredo vai no CAMINHO da URL
# (ex.: /api/messaging/telegram/SEU_SEGREDO) — segredo errado responde 404, então
# pra quem varre a internet a rota não existe.
MESSAGING_SECRET=

# Allowlist de quem pode mandar comando, separado por vírgula. SEM allowlist a
# rota RECUSA tudo: é o JARVIS que mexe no seu PC, e o padrão seguro é negar.
# O chat_id do Telegram aparece no corpo do próprio webhook na primeira mensagem.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
DISCORD_WEBHOOK_URL=
DISCORD_ALLOWED_USERS=

# Aviso: confirmação de ação de risco NÃO passa por aqui (Seção 13.3 rejeita
# aprovação no mesmo canal de chat). Ela continua na janela nativa do seu PC.

# ====================================================================
# CONECTORES (todos gratuitos)
# ====================================================================
# Notion — crie a integração em https://www.notion.so/my-integrations
NOTION_TOKEN=

# Figma — Settings > Personal access tokens (https://www.figma.com/developers/api#access-tokens)
FIGMA_TOKEN=

# Google (Gmail/Drive) — console.cloud.google.com > OAuth client (App da Web).
# Ative Gmail API e Drive API. Redirect abaixo deve estar autorizado no console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback

# Replicate (Geração de vídeo) — crie conta em https://replicate.com
# Uma chave única acessa: Kling AI, Runway Gen-3, Luma Dream Machine, Google Veo, etc.
# OPCIONAL aqui: o ideal é o site mandar a chave do usuário no header X-Replicate-Key.
REPLICATE_API_KEY=

# MCP não precisa de chave aqui — o server_url vai na chamada /api/mcp/tools

# ====================================================================
# VOZ — não se configura aqui
# ====================================================================
# TTS (Chatterbox/Kokoro) e STT (whisper.cpp) rodam no SEU PC, pelo Agente Local
# (Seção 14). Motor, voz, calibração e modelo do whisper se ajustam na aba de
# configuração de voz do painel, e ficam salvos em ~/.jarvis-agente. O servidor
# só faz a ponte — não guarda áudio nenhum.

# ---------------------------------------------------------------------------
# Backup automático do banco (app/autobackup.py)
# ---------------------------------------------------------------------------
# 0 = desligado (padrão). Escrever no disco de alguém sem ele pedir não é papel
# do programa. Com 6, o servidor tira um snapshot .json.gz a cada 6 horas.
#
# ONDE ISSO CAI: no disco DO SERVIDOR. Se o backend está publicado (Render), essa
# é uma cópia fora do teu PC. Se o backend roda no teu PC, é o MESMO disco do
# banco — protege contra apagar sem querer, não contra o HD morrer. Pra isso,
# baixe o snapshot de vez em quando (Configurações -> Dados & Backup).
#
# O snapshot NÃO contém token de pareamento nem a auditoria (registro encadeado
# deste banco; restaurar linhas de outro quebraria a verificação da cadeia).
BACKUP_EVERY_HOURS=0
BACKUP_KEEP=14
# Vazio = pasta "backups" ao lado do arquivo do banco.
BACKUP_DIR=
